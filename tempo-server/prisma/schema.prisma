generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  TEACHER
  STUDENT
  PARENT
  CUSTOMER
}

enum TeacherType {
  FULL_TIME
  PART_TIME
}

enum ZoneType {
  RECEPTION
  SHOWROOM
  STOCK_ROOM
  CLASSROOM
  OFFICE
  OTHER
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  passwordHash        String
  fullNameTh          String
  fullNameEn          String
  addressTh           String?
  addressEn           String?
  taxId               String?
  dateOfBirth         DateTime?
  phone               String?
  lineId              String?
  role                Role        @default(STAFF)
  teacherType         TeacherType?
  teacherGrade        String?
  monthlySalary       Int?
  isActive            Boolean     @default(true)
  mustChangePassword  Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdById         String
  updatedById         String

  branchAccess        UserBranch[]

  @@map("users")
}

model Branch {
  id                  String      @id @default(uuid())
  code                String      @unique
  nameTh              String
  nameEn              String
  phone               String?
  addressTh           String?
  addressEn           String?
  taxId               String?
  taxBranchNo         String?
  isVatRegistered     Boolean     @default(false)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdById         String
  updatedById         String

  userAccess          UserBranch[]
  zones               Zone[]

  @@map("branches")
}

model UserBranch {
  userId              String
  branchId            String
  createdAt           DateTime    @default(now())
  createdById         String

  user                User        @relation(fields: [userId], references: [id])
  branch              Branch      @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

model Zone {
  id                  String  @id @default(uuid())
  branchId            String
  parentId            String?
  code                String
  nameTh              String
  nameEn              String
  description         String?
  type                ZoneType  @default(CLASSROOM)
  maxCapacity         Int?
  isActive            Boolean  @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String
  updatedById         String

  branch              Branch  @relation(fields: [branchId], references: [id])
  parent              Zone?   @relation("ZoneHierarchy", fields: [parentId], references: [id])
  subZones            Zone[]  @relation("ZoneHierarchy")

  @@unique([branchId, code])
  @@index([branchId])
  @@index([parentId])
  @@map("zones")
}

enum CourseClassType {
  PRIVATE
  GROUP
}

model Course {
  id                  String  @id @default(cuid())
  code                String  @unique
  parentId            String?
  nameTh              String
  nameEn              String
  descriptionTh       String[]  @default([])
  descriptionEn       String[]  @default([])
  classType           CourseClassType @default(PRIVATE)
  totalLessons        Int?
  lessonDurationMin   Int?
  tuitionFee          Int?
  fulltimeTeachingFee Int?
  parttimeTeachingFee Int?
  isHighlighted       Boolean   @default(false)
  sortOrder           Int       @default(999)
  textbookId          String[]  @default([])
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String
  updatedById         String

  parent              Course?   @relation("CourseHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subCourses          Course[]  @relation("CourseHierarchy")

  @@index([parentId])
  @@index([isHighlighted, sortOrder])
  @@map("courses")
}